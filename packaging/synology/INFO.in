package="LinuxHAAgent"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="Linux HA Agent"
description="Reports this NAS to Home Assistant over MQTT: DSM and Package Center updates, Docker containers and image updates, CPU, memory and disk. Home Assistant can upgrade packages and containers and restart containers. DSM updates are only reported."
maintainer="linux-ha-agent"
maintainer_url="https://github.com/lvlie/linux-ha-agent"
support_url="https://github.com/lvlie/linux-ha-agent/blob/main/docs/synology.md"
arch="@ARCH@"
thirdparty="yes"
ctl_stop="yes"
install_reboot="no"
checksum="@CHECKSUM@"
